[Unit]
Description=GhostWatch website (Next.js)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=ghost
WorkingDirectory=/opt/ghostwatch
EnvironmentFile=/etc/ghostwatch/env
# Bound to localhost only; Caddy is the only thing that talks to it.
ExecStart=/usr/bin/npm run start -- -H 127.0.0.1 -p 3000
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/ghostwatch/.next /home/ghost
PrivateTmp=true

[Install]
WantedBy=multi-user.target

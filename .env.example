# Postgres. For local dev, `npm run db` starts an embedded PGlite server on 5433.
DATABASE_URL=postgres://postgres@127.0.0.1:5433/postgres?sslmode=disable
# 1 for PGlite (single underlying connection); 5+ for real Postgres.
DATABASE_POOL_MAX=1

# Bitcoin Core JSON-RPC endpoints, tried in order. Must support `getblock <hash> 3`.
# A private node: http://user:pass@127.0.0.1:8332
BITCOIN_RPC_URLS=https://bitcoin-rpc.publicnode.com

# Detection
MIN_DORMANT_YEARS=5
POLL_SECONDS=60

# Public URL used in permalinks, share cards and Telegram posts.
PUBLIC_BASE_URL=https://bitcoinghostwatch.com

# Telegram (optional). Leave empty to disable publishing.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_MIN_YEARS=10
TELEGRAM_MIN_BTC=1
